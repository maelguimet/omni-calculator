* text=auto eol=lf
*.bin binary
*.cact binary

# Preserve exact bytes of upstream files, hash-pinned fixtures, and evidence.
third_party/** -text -whitespace
vendor/** -text -whitespace
docs/evidence/** -text -whitespace
training/** -text
LICENSE -text -whitespace

# Vendored sources and generated outputs, exempt from scripts/check-file-size.
vendor/** linguist-vendored
third_party/** linguist-vendored
docs/evidence/*.json linguist-generated
training/**/*.jsonl linguist-generated
